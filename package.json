{
  "name": "ainx-lambda-monorepo",
  "version": "1.0.0",
  "description": "AWS Lambda monorepo with shared packages and infrastructure",
  "private": true,
  "workspaces": [
    "functions/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathIgnorePatterns=/node_modules/ --testPathPatterns=__tests__/integration",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "deploy:all": "npm run deploy --workspaces",
    "deploy:changed": "node scripts/deploy-changed.js",
    "deploy:agent-registration": "cd functions/agent-registration && npm run build && npm run package && aws lambda update-function-code --function-name agent-registration --zip-file fileb://dist/index.zip"
  },
  "devDependencies": {
    "@ainx/connection-utils": "*",
    "@ainx/crypto-utils": "*",
    "@ainx/did-utils": "*",
    "@aws-sdk/client-dynamodb": "^3.1100.0",
    "@aws-sdk/lib-dynamodb": "^3.1100.0",
    "@types/aws-lambda": "^8.10.149",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "axios": "^1.18.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.3.0",
    "jest": "^30.4.2",
    "prettier": "^3.5.0",
    "ts-jest": "^29.3.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainx/ainx-lambda.git"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "monorepo",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "uuid": "^11.1.0"
  }
}
