{
  "name": "ainx-lambda-monorepo",
  "version": "1.0.0",
  "description": "AWS Lambda monorepo with shared packages and infrastructure",
  "private": true,
  "workspaces": [
    "functions/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "deploy:all": "npm run deploy --workspaces",
    "deploy:changed": "node scripts/deploy-changed.js"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.131",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "esbuild": "^0.19.8",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainx/ainx-lambda.git"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "monorepo",
    "typescript"
  ],
  "license": "MIT"
}
