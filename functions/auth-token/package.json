{
  "name": "@ainx/auth-token",
  "version": "1.0.0",
  "description": "Auth token issuance Lambda function",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js",
    "build:watch": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js --watch",
    "test": "jest --config ../../jest.config.js",
    "test:watch": "jest --watch --config ../../jest.config.js",
    "test:coverage": "jest --coverage --config ../../jest.config.js",
    "test:integration": "jest --config ../../jest.config.js --testPathPattern=integration",
    "package": "npm run build && cd dist && zip -r index.zip index.js"
  },
  "dependencies": {
    "@ainx/crypto-utils": "^1.0.0",
    "@ainx/did-utils": "^1.0.0",
    "@ainx/logger": "^1.0.0",
    "@ainx/shared-utils": "^1.0.0",
    "jsonwebtoken": "^9.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/uuid": "^9.0.0",
    "esbuild": "^0.25.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.8.0"
  }
}
